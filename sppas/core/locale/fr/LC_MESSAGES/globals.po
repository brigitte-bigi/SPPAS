# ---------------------------------------------------------------------------
# Features
# ---------------------------------------------------------------------------
msgid "Updates the internal 'sppas' Python package"
msgstr "Met à jour le package Python interne 'sppas' utilisé par SPPAS. Présélectionné lorsqu'une mise à jour est disponible."

msgid "Installs Julius, FFmpeg and Praat executables inside the SPPAS package"
msgstr "Installe les exécutables Julius, FFmpeg et Praat dans le répertoire du package SPPAS (sans installation dans l'OS). Requis pour les annotations Alignement, Speech-To-Text et Formants. En installant, vous acceptez leurs licences respectives BSD-3 et GPL-3 (voir les fichiers LICENSE inclus)."

msgid "Installs Homebrew, then Julius, FFmpeg and Praat system-wide via Homebrew"
msgstr "Installe Homebrew, puis Julius, FFmpeg et Praat dans l'OS via Homebrew (droits administrateur requis). Requis pour les annotations Alignement, Speech-To-Text et Formants. En installant, vous acceptez leurs licences respectives BSD-3 et GPL-3."

msgid "Enables graphical interaction with SPPAS using its GUI"
msgstr "Active l'interface graphique de SPPAS. Cela installe wxPython, une boîte à outils Python open source et multiplateforme."

msgid "Enables the estimation of F1 and F2 formants"
msgstr "Active l’estimation des formants F1 et F2 avec des méthodes implémentées en interne et/ou avec les estimateurs de Praat."

msgid "Enables Whisper speech to text transcription"
msgstr "Active la transcription parole-vers-texte par Whisper, à l’intérieur des unités inter-pausales."

msgid "Adds audio playback support in the SPPAS Edit page"
msgstr "Ajoute la prise en charge de la lecture audio dans la page d’éditeur de l'interface graphique."

msgid "Enables image and video processing"
msgstr "Active le traitement des images et des vidéos. Requis pour les annotations de détection de visage, points faciaux, identité de visage de personne et anonymisation."

msgid "Integrates Google Mediapipe for advanced video processing"
msgstr "Intègre Google Mediapipe pour le traitement vidéo avancé, y compris la détection des mains et de la posture. IMPORTANT : activer cette fonctionnalité rendra SPPAS beaucoup plus lent et sans messages de journalisation."

msgid "Models for automatic face detection in images"
msgstr "Modèles pour la détection automatique de visages dans les images. (Téléchargement : 5,3 Mo). Nécessite la fonctionnalité 'video'."

msgid "Models for automatic detection of 68 facial landmarks in images"
msgstr "Modèles pour la détection automatique de 68 points faciaux dans les images. (Téléchargement : 106 Mo). Nécessite la fonctionnalité 'video'."

msgid "Automatic generation of Cued Speech"
msgstr "Génération automatique du Cued Speech, de la LfPC."

msgid "Support of American English Language"
msgstr "Prise en charge de l’anglais américain. Inclut un vocabulaire, un dictionnaire de prononciation et un modèle acoustique."

msgid "Support of French Language"
msgstr "Prise en charge du français. Inclut un vocabulaire, un dictionnaire de prononciation, un modèle acoustique, des règles de syllabification, etc."

msgid "Support of Quebec French Language"
msgstr "Prise en charge du français québécois. Inclut un dictionnaire de prononciation et un modèle acoustique."

msgid "Support of Bengali Language"
msgstr "Prise en charge du bengali. Inclut un vocabulaire, un dictionnaire de prononciation et un modèle acoustique."

msgid "Support of Catalan Language"
msgstr "Prise en charge du catalan. Inclut un vocabulaire, un dictionnaire de prononciation et un modèle acoustique."

msgid "Support of Mandarin Chinese Language"
msgstr "Prise en charge du chinois mandarin. Inclut un vocabulaire, un dictionnaire de prononciation et un modèle acoustique."

msgid "Support of German Language"
msgstr "Prise en charge de l’allemand. Inclut un vocabulaire, un dictionnaire de prononciation et un modèle acoustique."

msgid "Support of Dutch Language"
msgstr "Prise en charge du néerlandais. Inclut un vocabulaire, un dictionnaire de prononciation et un modèle acoustique."

msgid "Support of Hungarian Language"
msgstr "Prise en charge du hongrois. Inclut un vocabulaire."

msgid "Support of Italian Language"
msgstr "Prise en charge de l’italien. Inclut un vocabulaire, un dictionnaire de prononciation, un modèle acoustique et des règles de syllabification."

msgid "Support of Japanese Language"
msgstr "Prise en charge du japonais. Inclut un vocabulaire, un dictionnaire de prononciation et un modèle acoustique."

msgid "Support of Korean Language"
msgstr "Prise en charge du coréen [en développement]. Inclut un vocabulaire, un dictionnaire de prononciation et un modèle acoustique."

msgid "Support of Min Nan Language"
msgstr "Prise en charge du min nan. Inclut un vocabulaire, un dictionnaire de prononciation et un modèle acoustique."

msgid "Support of Naija Language"
msgstr "Prise en charge du naija (pidgin nigérian). Inclut un vocabulaire, un dictionnaire de prononciation et un modèle acoustique."

msgid "Support of Persian Language"
msgstr "Prise en charge du persan (iranien). Inclut un vocabulaire, un dictionnaire et un modèle acoustique."

msgid "Support of Polish Language"
msgstr "Prise en charge du polonais. Inclut un vocabulaire, un dictionnaire de prononciation, un modèle acoustique et des règles de syllabification. (Téléchargement : 4,6 Mo)"

msgid "Support of Portuguese Language"
msgstr "Prise en charge du portugais [en développement]. Inclut un vocabulaire, un dictionnaire de prononciation, un modèle acoustique."

msgid "Support of Spanish Language"
msgstr "Prise en charge de l’espagnol. Inclut un vocabulaire, un dictionnaire de prononciation, un modèle acoustique."

msgid "Support of Vietnamese Language"
msgstr "Prise en charge du vietnamien. Inclut un vocabulaire."

msgid "Support of Cantonese Language"
msgstr "Prise en charge du cantonais. Inclut un vocabulaire, un dictionnaire de prononciation, un modèle acoustique."

