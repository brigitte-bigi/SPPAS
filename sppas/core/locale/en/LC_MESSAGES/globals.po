# ---------------------------------------------------------------------------
# Features
# ---------------------------------------------------------------------------
msgid "Updates the internal 'sppas' Python package"
msgstr "Updates the internal 'sppas' Python package used by SPPAS. Pre-selected when an update is available."

msgid "Installs Julius, FFmpeg and Praat executables inside the SPPAS package"
msgstr "Installs Julius, FFmpeg and Praat executables inside the SPPAS package directory (no system-wide install). Required for Alignment, Speech-To-Text and Formants. By installing, you accept their respective BSD-3 and GPL-3 licenses (see included LICENSE files)."

msgid "Installs Homebrew, then Julius, FFmpeg and Praat system-wide via Homebrew"
msgstr "Installs Homebrew, then Julius, FFmpeg and Praat system-wide via Homebrew (requires administrator rights). Required for Alignment, Speech-To-Text and Formants. By installing, you accept their respective BSD-3 and GPL-3 licenses."

msgid "Enables graphical interaction with SPPAS using its GUI"
msgstr "Enables graphical interaction with SPPAS using its GUI. It installs wxPython, an open-source, cross-platform GUI toolkit for Python."

msgid "Enables the estimation of F1 and F2 formants"
msgstr "Enables the estimation of F1 and F2 formants with self-implemented methods, and/or with Praat estimators."

msgid "Enables Whisper speech to text transcription"
msgstr "Enables the speech to text transcription by Whisper, inside the Inter-Pausal Units."

msgid "Adds audio playback support in the SPPAS Edit page"
msgstr "Adds audio playback support in the SPPAS Edit page."

msgid "Enables image and video processing"
msgstr "Enables image and video processing. It is required for Face Detection, Face Landmarks, Person Face Identity, Anonymization annotations."

msgid "Integrates Google Mediapipe for advanced video processing"
msgstr "Integrates Google Mediapipe for advanced video processing, including hands and pose detection. IMPORTANT: Enabling this feature will make SPPAS much slower and without log messages."

msgid "Models for automatic face detection in images"
msgstr "Models for automatic face detection in images. (Download: 5.3Mb). Require 'video' feature."

msgid "Models for automatic detection of 68 facial landmarks in images"
msgstr "Models for automatic detection of 68 facial landmarks in images. (Download: 106Mb). Requires 'video' feature."

msgid "Automatic generation of Cued Speech"
msgstr "Automatic generation of Cued Speech. "

msgid "Support of American English Language"
msgstr "[already included] Support of American English Language. It includes a vocabulary, a pronunciation dictionary, and an acoustic model."

msgid "Support of French Language"
msgstr "[already included] Support of French Language. It includes a vocabulary, a pronunciation dictionary, an acoustic model, syllabification rules, etc."

msgid "Support of Quebec French Language"
msgstr "[already included] Support of Quebec French Language. It includes a pronunciation dictionary, and an acoustic model."

msgid "Support of Bengali Language"
msgstr "Support of Bengali Language. It includes a vocabulary, a pronunciation dictionary, and an acoustic model."

msgid "Support of Catalan Language"
msgstr "Support of Catalan Language. It includes a vocabulary, a pronunciation dictionary, and an acoustic model."

msgid "Support of Mandarin Chinese Language"
msgstr "Support of Mandarin Chinese Language. It includes a vocabulary, a pronunciation dictionary, and an acoustic model."

msgid "Support of German Language"
msgstr "Support of German Language. It includes a vocabulary, a pronunciation dictionary, and an acoustic model."

msgid "Support of Dutch Language"
msgstr "Support of Dutch Language. It includes a vocabulary, a pronunciation dictionary, and an acoustic model."

msgid "Support of Hungarian Language"
msgstr "Support of Hungarian Language. It includes a vocabulary."

msgid "Support of Italian Language"
msgstr "Support of Italian Language. It includes a vocabulary, a pronunciation dictionary, an acoustic model and syllabification rules."

msgid "Support of Japanese Language"
msgstr "Support of Japanese Language. It includes a vocabulary, a pronunciation dictionary, and an acoustic model."

msgid "Support of Korean Language"
msgstr "Support of Korean Language [under devel]. It includes a vocabulary, a pronunciation dictionary, and an acoustic model."

msgid "Support of Min Nan Language"
msgstr "Support of Min Nan Language. It includes a vocabulary, a pronunciation dictionary, and an acoustic model."

msgid "Support of Naija Language"
msgstr "Support of Naija Language (Nigerian Pidgin). It includes a vocabulary, a pronunciation dictionary, and an acoustic model."

msgid "Support of Persian Language"
msgstr "Support of Persian Language (Iranian). It includes a vocabulary, a dictionary and an acoustic model. "

msgid "Support of Polish Language"
msgstr "Support of Polish Language. It includes a vocabulary, a pronunciation dictionary, an acoustic model and rules for syllabification. (Download: 4.6Mb)"

msgid "Support of Portuguese Language"
msgstr "Support of Portuguese Language [under devel]. It includes a vocabulary, a pronunciation dictionary, an acoustic model."

msgid "Support of Spanish Language"
msgstr "Support of Spanish Language. It includes a vocabulary, a pronunciation dictionary, an acoustic model."

msgid "Support of Vietnamese Language"
msgstr "Support of Vietnamese Language. It includes a vocabulary."

msgid "Support of Cantonese Language"
msgstr "Support of Cantonese Language. It includes a vocabulary, a pronunciation dictionary, an acoustic model."

